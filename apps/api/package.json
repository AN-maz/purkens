{
  "name": "@bukens/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bukens-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bukens-db --remote",
    "db:seed:local": "wrangler d1 execute bukens-db --local --file=./seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
